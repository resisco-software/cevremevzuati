{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cevremevzuati-monitor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "MONITOR_ENABLED": "false",
    "SOURCE_VALIDATED": "false"
  },
  // 08:00 / 18:00 Europe/Istanbul starts scans; the second trigger drains jobs.
  // Disabled until account, storage, secret and real-source acceptance checks exist.
  "triggers": { "crons": [] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cevremevzuati-monitor",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{
    "binding": "EVIDENCE",
    "bucket_name": "cevremevzuati-monitor-evidence"
  }],
  "observability": { "enabled": true }
}
